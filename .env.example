# NEXUS AI Backend — variáveis de ambiente
# Copie para .env (não faça commit do .env)

# OBRIGATÓRIO em produção: token de acesso à API
NEXUS_AUTH_TOKEN=troque-por-um-token-forte

# OBRIGATÓRIO em produção: chave mestra do cofre (criptografia AES-256-GCM das API keys)
NEXUS_AUTH_TOKEN_EXEMPLO_NAO_USAR=veja-abaixo
NEXUS_MASTER_KEY=troque-por-uma-chave-aleatoria-longa

# Diretório do workspace dos usuários (jail de arquivos)
NEXUS_WORKSPACE=./data/workspace

# CORS: origem permitida para o frontend (ex.: site no GitHub Pages)
NEXUS_CORS=*

# Porta
PORT=3000
